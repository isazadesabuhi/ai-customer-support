# Local development only. Set these in the shell that starts Django.
# Load database variables from the root .env as described in docs/development/setup.md.
DJANGO_ENV=development
DJANGO_DEBUG=true
# Optional in development. Use a private, non-empty value for a stable key.
# DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional. Comma-separated origins, without paths or trailing slashes.
# DJANGO_FRONTEND_ORIGINS=http://localhost:3000

# Optional LLM configuration. Load these into the backend process environment.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=500
